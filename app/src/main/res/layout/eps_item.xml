<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Hình ảnh thumbnail -->
        <ImageView
            android:id="@+id/imgThumbnail"
            android:layout_width="120dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
             />

        <!-- Icon phát video -->
        <ImageView
            android:id="@+id/imgPlayIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"

            app:tint="@android:color/white" />

        <!-- Tên tập phim -->
        <TextView
            android:id="@+id/tvEpisodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgThumbnail"
            android:layout_marginStart="8dp"
            android:text="Tập 3"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Thời lượng tập phim -->
        <TextView
            android:id="@+id/tvEpisodeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgThumbnail"
            android:layout_below="@id/tvEpisodeTitle"
            android:layout_marginStart="8dp"
            android:text="50p"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Mô tả tập phim -->
        <TextView
            android:id="@+id/tvEpisodeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgThumbnail"
            android:layout_below="@id/tvEpisodeDuration"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="Mô tả nội dung tập phim..."
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Nút tải xuống -->
        <ImageView
            android:id="@+id/imgDownload"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"

            app:tint="@android:color/black" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
